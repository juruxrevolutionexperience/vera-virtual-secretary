# =============================================
# ai-service — Variables de entorno
# Copia este fichero como .env y rellena los valores
# =============================================

# Groq — LLM principal (LLaMA 3.3 70B)
# Obtener en: https://console.groq.com
GROQ_API_KEY=

# Google AI — embeddings RAG (gemini-embedding-001) + fallback LLM (Gemini 2.5 Flash-Lite)
# Obtener en: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Token secreto compartido con Laravel (debe ser idéntico al AI_SERVICE_SECRET del .env de Laravel)
# Generar con: openssl rand -hex 32
AI_SERVICE_SECRET=
